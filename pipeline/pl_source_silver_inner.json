{
	"name": "pl_source_silver_inner",
	"properties": {
		"activities": [
			{
				"name": "read table for each",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "AzureSqlSource",
						"sqlReaderQuery": {
							"value": "select * from ctrl.table_config where table_id = @{pipeline().parameters.table_id}",
							"type": "Expression"
						},
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "DS_AzureSqlTable1",
						"type": "DatasetReference"
					}
				}
			},
			{
				"name": "set start time",
				"type": "SetVariable",
				"dependsOn": [],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "starttime",
					"value": {
						"value": "@formatDateTime(utcNow(),'yyyy-MM-dd_hh:mm:ss')",
						"type": "Expression"
					}
				}
			},
			{
				"name": "source to landing",
				"type": "Copy",
				"dependsOn": [
					{
						"activity": "read table for each",
						"dependencyConditions": [
							"Succeeded"
						]
					},
					{
						"activity": "set start time",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "PostgreSqlV2Source",
						"query": {
							"value": "select * from PUBLIC.@{activity('read table for each').output.firstRow.source_table_name}",
							"type": "Expression"
						},
						"queryTimeout": "02:00:00"
					},
					"sink": {
						"type": "ParquetSink",
						"storeSettings": {
							"type": "AzureBlobFSWriteSettings"
						},
						"formatSettings": {
							"type": "ParquetWriteSettings"
						}
					},
					"enableStaging": false,
					"translator": {
						"type": "TabularTranslator",
						"typeConversion": true,
						"typeConversionSettings": {
							"allowDataTruncation": true,
							"treatBooleanAsNumber": false
						}
					}
				},
				"inputs": [
					{
						"referenceName": "DS_PostgreSqlTable",
						"type": "DatasetReference"
					}
				],
				"outputs": [
					{
						"referenceName": "DS_ADLS_Parquet",
						"type": "DatasetReference",
						"parameters": {
							"container": "landing",
							"folder": {
								"value": "@concat(\n    activity('read table for each').output.firstRow.source_system,\n    '/',activity('read table for each').output.firstRow.source_table_name,\n    '/',variables('starttime')\n)",
								"type": "Expression"
							}
						}
					}
				]
			},
			{
				"name": "landing_to_bronze",
				"type": "DatabricksNotebook",
				"dependsOn": [
					{
						"activity": "source to landing",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"notebookPath": "/bharath-dev-repo-P1/bharath_adb_repo/landing_to_bronze",
					"baseParameters": {
						"source_system": {
							"value": "@activity('read table for each').output.firstRow.source_system",
							"type": "Expression"
						},
						"table_name": {
							"value": "@activity('read table for each').output.firstRow.bronze_table_name",
							"type": "Expression"
						},
						"landing_timestamp": {
							"value": "@variables('starttime')",
							"type": "Expression"
						}
					}
				},
				"linkedServiceName": {
					"referenceName": "LS_AzureDatabricks1",
					"type": "LinkedServiceReference"
				}
			},
			{
				"name": "bronze_to_silver",
				"type": "DatabricksNotebook",
				"dependsOn": [
					{
						"activity": "landing_to_bronze",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"notebookPath": "/bharath-dev-repo-P1/bharath_adb_repo/bronze_to_silver",
					"baseParameters": {
						"table_name": {
							"value": "@activity('read table for each').output.firstRow.silver_table_name",
							"type": "Expression"
						},
						"landing_timestamp": {
							"value": "@variables('starttime')",
							"type": "Expression"
						}
					}
				},
				"linkedServiceName": {
					"referenceName": "LS_AzureDatabricks1",
					"type": "LinkedServiceReference"
				}
			},
			{
				"name": "update in Succes status",
				"type": "Script",
				"dependsOn": [
					{
						"activity": "bronze_to_silver",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 2,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"linkedServiceName": {
					"referenceName": "LS_AzureSqlDatabase1",
					"type": "LinkedServiceReference"
				},
				"typeProperties": {
					"scripts": [
						{
							"type": "Query",
							"text": {
								"value": "update ctrl.audit_log\nset status = 'SUCCESS',end_time = SYSUTCDATETIME(),records_written = @{activity('bronze_to_silver').output.runOutput}\nwhere adf_run_id  ='@{pipeline().parameters.adf_runid}' and table_id = @{pipeline().parameters.table_id}",
								"type": "Expression"
							}
						}
					],
					"scriptBlockExecutionTimeout": "02:00:00"
				}
			}
		],
		"parameters": {
			"table_id": {
				"type": "string",
				"defaultValue": "1"
			},
			"adf_runid": {
				"type": "string",
				"defaultValue": "a1"
			}
		},
		"variables": {
			"starttime": {
				"type": "String"
			}
		},
		"annotations": []
	}
}