{
	"name": "pl_send_email",
	"properties": {
		"activities": [
			{
				"name": "read all tables status",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "AzureSqlSource",
						"sqlReaderQuery": {
							"value": "select * from ctrl.audit_log where adf_run_id =  '@{pipeline().parameters.adf_run_id}'",
							"type": "Expression"
						},
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "DS_AzureSqlTable1",
						"type": "DatasetReference"
					},
					"firstRowOnly": false
				}
			},
			{
				"name": "prepare email body header",
				"type": "SetVariable",
				"dependsOn": [],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "body_header",
					"value": "ingestion and transformation has been completed below is the status and log"
				}
			},
			{
				"name": "prepare email body footer",
				"type": "SetVariable",
				"dependsOn": [],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "body_footer",
					"value": "for any support please reach out to \nbvmbharath@gmail.com"
				}
			},
			{
				"name": "prepare email subject",
				"type": "SetVariable",
				"dependsOn": [
					{
						"activity": "check overall failed count",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "email_subject",
					"value": {
						"value": "@concat(\n    pipeline().globalParameters.env,\n    ' | ',\n    if(\n        greater(activity('check overall failed count').output.firstRow.count, 0),\n        'FAILED',\n        'SUCCESS'\n    ),\n    ' | CARESYNC MASTER RUN'\n)",
						"type": "Expression"
					}
				}
			},
			{
				"name": "check overall failed count",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 2,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "AzureSqlSource",
						"sqlReaderQuery": {
							"value": "select count(*) as count from ctrl.audit_log where adf_run_id =  '@{pipeline().parameters.adf_run_id}'\nand status != 'SUCCESS'",
							"type": "Expression"
						},
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "DS_AzureSqlTable1",
						"type": "DatasetReference"
					}
				}
			},
			{
				"name": "prepare logic apps body",
				"type": "SetVariable",
				"dependsOn": [
					{
						"activity": "prepare email subject",
						"dependencyConditions": [
							"Succeeded"
						]
					},
					{
						"activity": "prepare email body footer",
						"dependencyConditions": [
							"Succeeded"
						]
					},
					{
						"activity": "prepare email body header",
						"dependencyConditions": [
							"Succeeded"
						]
					},
					{
						"activity": "read all tables status",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "logicapps_body",
					"value": {
						"value": "{\n  \"subject\": \"@{variables('email_subject')}\",\n  \"email recipients\": \"@{pipeline().globalParameters.email_receipients}\",\n  \"body header\": \"@{variables('body_header')}\",\n  \"body footer\": \"@{variables('body_footer')}\",\n  \"status table\": @{activity('read all tables status').output.value}\n}",
						"type": "Expression"
					}
				}
			},
			{
				"name": "send email",
				"type": "WebActivity",
				"dependsOn": [
					{
						"activity": "prepare logic apps body",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"method": "POST",
					"headers": {
						"Content-Type": "application/json"
					},
					"url": {
						"value": "@pipeline().globalParameters.logicapp_url",
						"type": "Expression"
					},
					"body": {
						"value": "@variables('logicapps_body')",
						"type": "Expression"
					}
				}
			}
		],
		"parameters": {
			"adf_run_id": {
				"type": "string"
			}
		},
		"variables": {
			"body_header": {
				"type": "String"
			},
			"body_footer": {
				"type": "String"
			},
			"email_subject": {
				"type": "String"
			},
			"logicapps_body": {
				"type": "String"
			}
		},
		"annotations": []
	}
}